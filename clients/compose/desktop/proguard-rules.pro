# ProGuard rules for the release build of the monitor window.

# ProGuard's method specialization narrows Compose's derivedStateOf to return
# DerivedSnapshotState while the body still returns a State, and the JVM refuses to load it
# (VerifyError: Bad return type).
-optimizations !method/specialization/*

# The messages are generated by Wire and read reflectively by its Moshi adapter.
-keep class mason.** { *; }
-keep class com.squareup.wire.** { *; }
-keep class com.squareup.moshi.** { *; }
-keep class org.json.** { *; }

# OkHttp and Okio refer to optional platform classes that are not on the classpath.
-dontwarn okhttp3.internal.platform.**
-dontwarn org.conscrypt.**
-dontwarn org.bouncycastle.**
-dontwarn org.openjsse.**
-dontwarn com.squareup.wire.**
-dontwarn com.squareup.moshi.**
-dontwarn kotlinx.coroutines.**

# kotlinx-datetime's serializers refer to kotlinx-serialization, which the monitor does not use.
-dontwarn kotlinx.datetime.**
