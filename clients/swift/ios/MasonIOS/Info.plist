<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The app icon is Assets.xcassets/AppIcon.appiconset (the mascot, copied from
       clients/swift/Sources/MasonMascot/Art/brand/app_icon.png). The bundle id and team come
       from build settings (see ../project.yml). -->
  <key>CFBundleName</key><string>MASON</string>
  <key>CFBundleDisplayName</key><string>MASON</string>
  <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
  <key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
  <key>ITSAppUsesNonExemptEncryption</key><false/>
  <key>UILaunchScreen</key><dict/>
  <key>UISupportedInterfaceOrientations</key>
  <array><string>UIInterfaceOrientationPortrait</string></array>
  <key>UISupportedInterfaceOrientations~ipad</key>
  <array>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>
  <key>NSLocalNetworkUsageDescription</key>
  <string>MASON looks for your daemon on the local network so this phone can pair with it.</string>
  <key>NSBonjourServices</key>
  <array><string>_mason._tcp</string></array>
  <key>UIBackgroundModes</key>
  <array><string>remote-notification</string></array>
</dict>
</plist>
